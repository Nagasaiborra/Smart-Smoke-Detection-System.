/**************************************************/

void resetEmailFlags()
{
    warningMailSent=false;

    dangerMailSent=false;
}
/**************************************************
                SENSOR FUNCTIONS
**************************************************/

void readSensors()
{
    smokeAverage = getAverageSmoke();

    temperature = dht.readTemperature();
    humidity = dht.readHumidity();

    if(isnan(temperature))
        temperature = 0;

    if(isnan(humidity))
        humidity = 0;
}

/**************************************************/

void determineStatus()
{
    if(smokeAverage >= DANGER_SMOKE || temperature >= DANGER_TEMP)
    {
        currentStatus = DANGER;
    }

    else if(smokeAverage >= WARNING_SMOKE || temperature >= WARNING_TEMP)
    {
        currentStatus = WARNING;
    }

    else
    {
        currentStatus = SAFE;
    }
}

/**************************************************/

void updateOutputs()
{
    switch(currentStatus)
    {

    /************* SAFE ****************/

    case SAFE:

        digitalWrite(GREEN_LED,HIGH);
        digitalWrite(RED_LED,LOW);
        digitalWrite(BUZZER_PIN,LOW);

        warningDisplayed=false;
        dangerDisplayed=false;

        resetEmailFlags();

        break;

    /************* WARNING *************/

    case WARNING:

        digitalWrite(GREEN_LED,LOW);

        if(millis()-previousBlink>500)
        {
            previousBlink=millis();

            blinkState=!blinkState;

            digitalWrite(RED_LED,blinkState);
            digitalWrite(BUZZER_PIN,blinkState);
        }

        if(!warningDisplayed)
        {
            Serial.println();
            Serial.println("========== WARNING ==========");
            Serial.println("Smoke Increasing");
            Serial.println("=============================");

            sendWarningEmail();

            warningDisplayed=true;
        }

        break;

    /************* DANGER **************/

    case DANGER:

        digitalWrite(GREEN_LED,LOW);

        digitalWrite(RED_LED,HIGH);

        digitalWrite(BUZZER_PIN,HIGH);

        if(!dangerDisplayed)
        {
            Serial.println();
            Serial.println("========= FIRE ALERT =========");
            Serial.println("DANGER LEVEL");
            Serial.println("==============================");

            sendDangerEmail();

            dangerDisplayed=true;
        }

        break;

    }

}

/**************************************************/

void printDashboard()
{

    Serial.println();

    Serial.println("---------------------------------------");

    Serial.print("Smoke Value : ");
    Serial.println(smokeAverage);

    Serial.print("Temperature : ");
    Serial.print(temperature);
    Serial.println(" C");

    Serial.print("Humidity : ");
    Serial.print(humidity);
    Serial.println(" %");

    Serial.print("WiFi : ");

    if(WiFi.status()==WL_CONNECTED)
        Serial.println("Connected");
    else
        Serial.println("Disconnected");

    Serial.print("Current Status : ");

    switch(currentStatus)
    {

        case SAFE:
        Serial.println("SAFE");
        break;

        case WARNING:
        Serial.println("WARNING");
        break;

        case DANGER:
        Serial.println("DANGER");
        break;

    }

    Serial.println("---------------------------------------");

}
/**************************************************
                    SETUP
**************************************************/

void setup()
{
    Serial.begin(115200);

    delay(1000);

    pinMode(GREEN_LED, OUTPUT);
    pinMode(RED_LED, OUTPUT);
    pinMode(BUZZER_PIN, OUTPUT);

    digitalWrite(GREEN_LED, LOW);
    digitalWrite(RED_LED, LOW);
    digitalWrite(BUZZER_PIN, LOW);

    dht.begin();

    connectWiFi();

    connectSMTP();

    Serial.println();
    Serial.println("======================================");
    Serial.println(" SMART SMOKE DETECTOR STARTED ");
    Serial.println("======================================");
}

/**************************************************
                     LOOP
**************************************************/

void loop()
{
    // Read all sensors
    readSensors();

    // Decide SAFE / WARNING / DANGER
    determineStatus();

    // Update LEDs, buzzer and emails
    updateOutputs();

    // Show values in Serial Monitor
    printDashboard();

    delay(1000);
}