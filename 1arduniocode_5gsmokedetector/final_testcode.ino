#define RECIPTENT3 "aniborra5757@gmail.com"

#define SSL_MODE true
#define AUTHENTICATION true
#define NOTIFY "SUCCESS,FAILURE"

/******************** PINS ************************/

#define MQ2_PIN 1

#define DHT_PIN 2
#define DHTTYPE DHT22

#define GREEN_LED 4
#define RED_LED 5

#define BUZZER_PIN 6

/******************** LIMITS **********************/

const int WARNING_SMOKE = 1200;
const int DANGER_SMOKE = 2000;

const float WARNING_TEMP = 35.0;
const float DANGER_TEMP = 45.0;

/******************** OBJECTS *********************/

DHT dht(DHT_PIN, DHTTYPE);

WiFiClientSecure ssl_client;
SMTPClient smtp(ssl_client);

/******************** VARIABLES *******************/

int smokeValue = 0;
int smokeAverage = 0;

float temperature = 0;
float humidity = 0;

bool warningMailSent = false;
bool dangerMailSent = false;

bool warningDisplayed = false;
bool dangerDisplayed = false;

unsigned long previousBlink = 0;
bool blinkState = false;

enum SmokeSTATUS
{
    SAFE,
    WARNING,
    DANGER
};

SmokeSTATUS currentStatus = SAFE;

/**************************************************/

void smtpCallback(SMTPStatus status)
{
    if(status.progress.available)
    {
        ReadyMail.printf(
        "Uploading %d %%\n",
        status.progress.value);
    }
    else
    {
       ReadyMail.printf("%s\n", status.text.c_str());
    }
}

/**************************************************/

void connectWiFi()
{
    Serial.println();
    Serial.println("Connecting WiFi");

    WiFi.begin("Meghana","12345678");

    while(WiFi.status()!=WL_CONNECTED)
    {
        Serial.print(".");
        delay(500);
    }

    Serial.println();
    Serial.println("WiFi Connected");
    Serial.print("IP : ");
    Serial.println(WiFi.localIP());
}

/**************************************************/

void connectSMTP()
{
    ssl_client.setInsecure();

    smtp.connect(
        SMTP_HOST,
        SMTP_PORT,
        smtpCallback,
        SSL_MODE);

    if(!smtp.isConnected())
    {
        Serial.println("SMTP Connection Failed");
        return;
    }

    smtp.authenticate(
        AUTHOR_EMAIL,
        AUTHOR_PASSWORD,
        readymail_auth_password);

    if(!smtp.isAuthenticated())
    {
        Serial.println("SMTP Authentication Failed");
        return;
    }

    Serial.println("SMTP Ready");
}

/**************************************************/

int getAverageSmoke()
{
    long total = 0;

    for(int i=0;i<10;i++)
    {
        total += analogRead(MQ2_PIN);
        delay(10);
    }

    return total/10;
}
/**************************************************
                EMAIL FUNCTIONS
**************************************************/

void sendWarningEmail()
{
    if(warningMailSent) return;

    SMTPMessage msg;

    msg.headers.add(rfc822_subject,
        "⚠ WARNING : Smoke Increasing");

    msg.headers.add(
        rfc822_from,
        "ESP32 Smoke Detector <" + String(AUTHOR_EMAIL) + ">");

    msg.headers.add(
        rfc822_to,
        "User1 <" + String(RECIPIENT1) + ">");

    msg.headers.add(
        rfc822_to,
        "User2 <" + String(RECIPIENT2) + ">");

    String body;

    body += "WARNING\r\n\r\n";
    body += "Smoke Level Increasing.\r\n\r\n";

    body += "Smoke Value : ";
    body += String(smokeAverage);

    body += "\r\nTemperature : ";
    body += String(temperature);

    body += " C\r\nHumidity : ";
    body += String(humidity);

    body += " %\r\n\r\n";

    body += "Please inspect the location.\r\n\r\n";

    body += "Generated by ESP32 Smoke Detector.";

    msg.text.body(body);

    String html = body;
    html.replace("\r\n","<br>");

    msg.html.body(
    "<html><body>"
    "<h2 style='color:orange;'>⚠ WARNING</h2>"
    "<p>"+html+"</p>"
    "</body></html>");

    Serial.println("Sending WARNING Email...");

    smtp.send(msg,NOTIFY);

    warningMailSent=true;

    Serial.println("WARNING Email Sent");
}

